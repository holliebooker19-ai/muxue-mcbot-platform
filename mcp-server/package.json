    "mineflayer-pathfinder": "^2.4.2",
    "pngjs": "^7.0.0",
    "prismarine-nbt": "^2.8.0",
    "prismarine-viewer": "^1.33.0",
    "puppeteer-core": "^25.11.0",
    "vec3": "^0.1.8",
    "yargs": "^18.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/pngjs": "^6.0.5",
    "@types/yargs": "^17.0.35",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.10.0"
  }
